# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE MONITORIZACIÓN DE CONSUMO ENERGÉTICO
# ==============================================================================

# Puerto de la API Backend
PORT=5000

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS NEON (PostgreSQL)
# ------------------------------------------------------------------------------
# Copia la cadena de conexión pooled de tu panel de Neon (https://console.neon.tech)
# Ejemplo: postgresql://neondb_owner:npg_xxxx@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE ALERTAS POR GMAIL (SMTP)
# ------------------------------------------------------------------------------
# Dirección de correo de Gmail desde la que se enviarán las alertas
GMAIL_USER=tu_cuenta@gmail.com

# Contraseña de aplicación de Google de 16 caracteres (App Password)
# Para generarla: 
# 1. Ve a https://myaccount.google.com/security
# 2. Asegúrate de tener activada la Verificación en 2 pasos
# 3. Busca "Contraseñas de aplicaciones" (App passwords) y crea una con nombre "EnergyMonitor"
# 4. Pega aquí el código de 16 caracteres generado (sin espacios)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Dirección de correo que recibirá las notificaciones de alerta crítica
ALERT_RECIPIENT_EMAIL=responsable_mantenimiento@gmail.com

# Intervalo mínimo de enfriamiento entre correos por la misma máquina (en minutos)
ALERT_COOLDOWN_MINUTES=5
